FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 FACEFARE_DEMO=1 FACEFARE_DATA_DIR=/data
WORKDIR /app
COPY requirements-demo.txt ./
RUN pip install --no-cache-dir -r requirements-demo.txt 'gunicorn>=23,<26' \
    && useradd --create-home facefare && mkdir /data && chown facefare /data
COPY --chown=facefare:facefare . .
USER facefare
EXPOSE 5000
CMD ["gunicorn", "--workers", "1", "--threads", "8", "--bind", "0.0.0.0:5000", "app:app"]
